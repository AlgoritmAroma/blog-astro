# Copy to .env.production on the VPS and fill in real values.
# docker-compose.yml loads this via `env_file:` for the `db`, `blog`, and
# `admin` services — Compose passes it straight through as container env
# vars with no parsing/expansion, so unlike .env.local (loaded by Next's own
# dotenv-expand, which treats `$` as variable interpolation and silently
# mangles bcrypt hashes) the `$` in ADMIN_PASSWORD_HASH below does NOT need
# escaping here. `blog` ignores the ADMIN_*/SESSION_SECRET vars below (it
# has no auth); `admin` ignores NEXT_PUBLIC_BLOG_URL's absence gracefully
# (falls back to the production blog URL hardcoded in its layout).

ADMIN_USERNAME=admin

# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true once the admin service is behind real TLS (reverse proxy/Caddy
# on the VPS) — until then, "true" here makes the browser silently drop the
# admin session cookie over plain HTTP with no visible error.
COOKIE_SECURE=false

# admin's "Открыть блог" link — the public site's real URL, since admin no
# longer shares an origin with it.
NEXT_PUBLIC_BLOG_URL=https://aiastro.ru

# --- Postgres (shared by both apps) ---
# POSTGRES_USER/PASSWORD/DB configure the `db` container itself (read by the
# official postgres image). DATABASE_URL is what both apps connect with —
# its host/user/password/db MUST match the three vars above (env_file doesn't
# support referencing other vars, so keep them in sync by hand). `db` as the
# host is the docker-compose service name, resolved via Compose's internal
# network — not localhost.
POSTGRES_USER=blog
POSTGRES_PASSWORD=
POSTGRES_DB=blog
DATABASE_URL=postgres://blog:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/blog
